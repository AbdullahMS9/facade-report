# Copy to .env.local and fill in real values. Never commit .env.local.

# Supabase project (Settings > API). Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SERVER ONLY. Bypasses Row Level Security. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# NYC Open Data app token (free, raises rate limits). Server only.
NYC_OPEN_DATA_APP_TOKEN=your-app-token
